# Hatchlybox Engine on Windows: the engine runs in WSL (Ubuntu by default), the desktop front end in the Windows browser.
HOST=windows
HOST_NAME="Hatchlybox for Windows"
SERVE_PORT=8765
# adb in WSL: phones over wireless debugging (USB needs usbipd-win), the standard port.
ADB_PORT=5037
OPENCODE_ARGS=""
OPENCODE_PERMISSION='{"*":"allow"}'
CAPABILITIES="android-deliver"
# Windows versions install on the Windows side (here.sh: %LOCALAPPDATA%\Programs\Hatchlybox and the Start menu).
INSTALLS="windows"

# Phones are on the network; built APKs are offered to phones on the same Wi-Fi (reachable with WSL's mirrored
# networking, which install-windows.ps1 offers to turn on).
ADB_SELF=0
SERVE_LAN=1

# Agents and builds run only in a sandbox (bubblewrap in WSL, which also keeps the Windows drives out of reach).
ISOLATION=required
