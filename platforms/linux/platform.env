# Hatchlybox Engine on a Linux computer (the desktop front end, or the command line).
HOST=linux
HOST_NAME="Hatchlybox for Linux"
# Downloads of built APKs for a phone on the same machine's browser (not reachable from elsewhere).
SERVE_PORT=8765
# The computer's own adb server, the standard port.
ADB_PORT=5037
OPENCODE_ARGS=""
OPENCODE_PERMISSION='{"*":"allow"}'
CAPABILITIES="android-deliver"
# Linux versions install here (here.sh; Omarchy versions too where Omarchy is); the library exports the rest.
INSTALLS="linux"

# Phones are on USB or the network (not this machine); built APKs are offered to phones on the same Wi-Fi.
ADB_SELF=0
SERVE_LAN=1

# Agents and builds run only in a sandbox (bubblewrap on Linux, sandbox-exec on macOS); hatchlybox set agentIsolation compatible allows without.
ISOLATION=required
